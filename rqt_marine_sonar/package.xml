<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rqt_marine_sonar</name>
  <version>0.1.0</version>
  <description>
    rqt water-column echogram viewer for marine_acoustic_msgs/RawSonarImage.
    Renders a depth-vs-ping "curtain" from a single-beam sonar (or the nadir
    beam of a multibeam): a QtCharts depth axis over a grayscale, depth-binned
    image with mouse-wheel depth zoom and drag pan. Complements
    rqt_sonar_waterfall (cross-track sidescan backscatter).
  </description>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <build_depend>qtbase5-dev</build_depend>
  <!-- rosdep key (resolves to apt libqt5charts5-dev); the apt name itself is
       not a rosdep key, so CI's rosdep install would silently skip it. -->
  <build_depend>libqt5-charts-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_cpp</depend>
  <depend>qt_gui_cpp</depend>
  <depend>pluginlib</depend>
  <depend>marine_acoustic_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
