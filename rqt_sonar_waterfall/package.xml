<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rqt_sonar_waterfall</name>
  <version>0.1.0</version>
  <description>
    rqt waterfall viewer for marine_acoustic_msgs/RawSonarImage. Renders a
    scrolling backscatter waterfall (sidescan port|starboard), with client-side
    image processing and an optional generic sonar-control panel driven by
    marine_radar_control_msgs.
  </description>
  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <build_depend>qtbase5-dev</build_depend>
  <!-- The exported library links Qt5::OpenGL, so downstream builders need the
       Qt OpenGL dev package too (build_export), not just this package's own
       build. -->
  <build_depend>libqt5opengl5-dev</build_depend>
  <build_export_depend>libqt5opengl5-dev</build_export_depend>

  <depend>rclcpp</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_cpp</depend>
  <depend>qt_gui_cpp</depend>
  <depend>pluginlib</depend>
  <depend>marine_acoustic_msgs</depend>
  <depend>marine_radar_control_msgs</depend>
  <depend>marine_colormap</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_cpp</depend>

  <!-- synthetic_sidescan.py test publisher -->
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
